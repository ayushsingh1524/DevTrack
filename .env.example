# ==========================================
# DevTrack Environment Configuration
# Copy this file to .env and configure
# ==========================================

# ------------------------------------------
# Backend Configuration (FastAPI)
# ------------------------------------------
PROJECT_NAME="DevTrack"
API_V1_STR="/api/v1"

# Generate a strong 32-byte secret key (e.g. `openssl rand -hex 32`)
SECRET_KEY="your-super-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="30"
REFRESH_TOKEN_EXPIRE_DAYS="7"

# Database Connections
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_password"
POSTGRES_DB="devtrack"

# When running via Docker, this is the internal network URL
DATABASE_URL="postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}"
REDIS_URL="redis://redis:6379/0"

# GitHub OAuth Integration (Optional)
# Create at https://github.com/settings/developers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ------------------------------------------
# Frontend Configuration (Next.js)
# ------------------------------------------
# The base domain where DevTrack is hosted (e.g., devtrack.com)
DOMAIN="localhost"

# Public API endpoints
NEXT_PUBLIC_API_URL="http://localhost/api/v1"
NEXT_PUBLIC_WS_URL="ws://localhost/api/v1/ws"
